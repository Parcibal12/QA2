		{
			"name": "eliminar usuario",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200, 204 o 404\", function () {\r",
							"    pm.expect([200, 204, 404]).to.include(pm.response.code);\r",
							"});\r",
							"\r",
							"let userId = pm.environment.get(\"userId\");\r",
							"\r",
							"if (userId) {\r",
							"    pm.sendRequest({\r",
							"        url: pm.environment.get(\"baseUrl\") + \"/users/\" + userId,\r",
							"        method: \"GET\"\r",
							"    }, function (err, res) {\r",
							"        if (err) {\r",
							"            console.log(\"Error en request:\", err);\r",
							"        } else {\r",
							"            pm.test(\"Usuario realmente eliminado\", function () {\r",
							"                pm.expect([404, 400]).to.include(res.code);\r",
							"            });\r",
							"        }\r",
							"    });\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
